{
  "services": {
    "frontend": {
      "root": "frontend/",
      "buildCommand": "vite build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "api/main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build"
      }
    }
  ]
}
